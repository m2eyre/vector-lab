# ---------------------------------------------------------------------------------------
# FRONTEND (public, baked into the browser bundle by Vite). Safe to expose.
# Leave all of these unset for a fully offline build.
# ---------------------------------------------------------------------------------------
# Your Supabase project URL and its *anon* (public) key. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: override the API location (defaults to <VITE_SUPABASE_URL>/functions/v1/api).
# For local development against `npm run dev:api` use http://localhost:8787
VITE_API_URL=
# Optional: "placeholder" draws labelled ad boxes for layout testing. No real ads either way.
VITE_ADS_PROVIDER=

# ---------------------------------------------------------------------------------------
# SERVER (secrets). Set with `supabase secrets set ...` or in your CI, never in the frontend.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_DB_URL are injected into Edge Functions
# automatically by Supabase.
# ---------------------------------------------------------------------------------------
# Enables the AI challenge designer. Without it the procedural designer is used.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5).
AI_DESIGNER_MODEL=
# Shared secret required by POST /cron/publish. Use a long random string.
CRON_SECRET=
# Optional: restrict browser access to your site, e.g. https://vectorlab.example.com
ALLOWED_ORIGIN=
# For `npm run publish:daily` / GitHub Actions / local dev: a Postgres connection string.
DATABASE_URL=
